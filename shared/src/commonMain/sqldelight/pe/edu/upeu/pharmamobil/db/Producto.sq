-- Sesion 11: copia local del inventario. La interfaz lee SIEMPRE de aqui (fuente de verdad);
-- la red solo mantiene esta tabla al dia.
-- Ademas de las columnas de la guia se guardan categoria_id (PharmaSoft la exige al editar)
-- y activo (los dados de baja se muestran aparte y se pueden reactivar).
CREATE TABLE producto (
    id           INTEGER NOT NULL PRIMARY KEY,
    nombre       TEXT    NOT NULL,
    precio       REAL    NOT NULL,
    stock        INTEGER NOT NULL,
    categoria_id INTEGER,
    activo       INTEGER NOT NULL DEFAULT 1,
    -- 1 = creado o modificado en el dispositivo y el servidor todavia no lo conoce.
    pendiente    INTEGER NOT NULL DEFAULT 0
);

listarTodos:
-- Lo pendiente primero (es lo que el usuario acaba de crear y aun no esta en el servidor);
-- el resto, por nombre.
SELECT * FROM producto ORDER BY pendiente DESC, nombre ASC;

listarPendientes:
-- Los ids locales bajan (-1, -2, ...): DESC los entrega en el orden en que se crearon.
SELECT * FROM producto WHERE pendiente = 1 ORDER BY id DESC;

obtenerPorId:
SELECT * FROM producto WHERE id = ?;

insertar:
INSERT OR REPLACE INTO producto
VALUES (?, ?, ?, ?, ?, ?, ?);

borrarSincronizados:
DELETE FROM producto WHERE pendiente = 0;

borrarPorId:
DELETE FROM producto WHERE id = ?;

marcarDeBaja:
UPDATE producto SET activo = 0 WHERE id = ?;

siguienteIdLocal:
-- COALESCE evita el NULL de la tabla vacia; el minOf de Kotlin
-- garantiza que el id resultante sea siempre negativo.
SELECT COALESCE(MIN(id), 0) FROM producto;
